---
layout: null
permalink: /feed.xml
---
{%- comment -%}
  The feed (Atom): the latest 20 posts, whole, for feed readers. No plugin
  needed: Jekyll fills this template in like any page. Each post says its
  stream (by number) and its writer's name (plain text, as on the site).
  Full web addresses come from `url` in _config.yml: set it when the site
  is published, or feed readers can't follow the links.
{%- endcomment -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/' | absolute_url | xml_escape }}</id>
  <updated>{{ site.posts.first.date | default: site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.title | xml_escape }}</name></author>
  <rights>© {{ site.time | date: "%Y" }} {{ site.title | xml_escape }}. Share with credit and a link, unchanged, non-commercial. Not for AI training.</rights>
  {%- for post in site.posts limit: 20 %}
  {%- include stream-find.html name=post.style %}
  {%- assign writer = site.data.authors[post.author] %}
  <entry xml:base="{{ post.url | absolute_url }}">
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    {%- if writer %}
    <author><name>{{ writer.name | xml_escape }}</name></author>
    {%- endif %}
    {%- if stream %}
    <category term="stream-{{ stream_n }}" label="Stream {{ stream_n }}"/>
    {%- endif %}
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {%- endfor %}
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
